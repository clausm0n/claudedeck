{
  "name": "@claudedeck/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o claudedeck.ehpk",
    "simulate": "evenhub-simulator --automation-port 9898 http://localhost:5173",
    "qr": "node scripts/qr.mjs"
  },
  "dependencies": {
    "@claudedeck/shared": "*",
    "@evenrealities/even_hub_sdk": "^0.0.14",
    "@evenrealities/pretext": "latest"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
